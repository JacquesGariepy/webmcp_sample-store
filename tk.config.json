{
  "version": 1,
  "lang": "en",
  "git": {
    "autoSync": "commit"
  },
  "policy": {},
  "projects": {
    "webmcp": {
      "repos": [
        "JacquesGariepy/webmcp_sample"
      ],
      "tracker": {
        "provider": "github",
        "channel": "cli",
        "writes": {
          "in_progress": {
            "labels": [
              "in-progress"
            ]
          },
          "awaiting_human": {
            "labels": [
              "needs-decision"
            ]
          },
          "in_review": {
            "labels": [
              "in-review"
            ]
          }
        }
      },
      "owners": [
        "jacques.gariepy@aspynai.com"
      ]
    }
  },
  "workflow": {
    "taskTypes": [
      "epic",
      "feature",
      "deliverable",
      "task",
      "implementation",
      "bugfix",
      "defect",
      "refactor",
      "security",
      "database_migration",
      "test",
      "research",
      "spike",
      "documentation",
      "design",
      "architecture",
      "integration",
      "release",
      "deployment",
      "requirements",
      "discovery",
      "governance",
      "audit",
      "review",
      "pr_review",
      "maintenance",
      "incident"
    ]
  },
  "requiredReplayFeatures": {
    "schema": "tk.required-replay-features/v1",
    "eventVersion": 2,
    "features": {
      "taskMove": 1,
      "leaseReap": 1,
      "conditionalAbandon": 1,
      "routingDecision": 1,
      "approval": 1,
      "notification": 1,
      "jevAssessment": 1
    }
  },
  "jev": {
    "mode": "shadow",
    "provider": "typesafe",
    "model": "jev-1.13.0",
    "apiKeyEnv": "TYPESAFE_API_KEY",
    "allowedProjects": [
      "webmcp"
    ],
    "expectedServedModel": "jev-1.13.0"
  }
}
